float4 TOPT_M_Taps32_PS0(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
	const float2 px = 1.0 / float2(BUFFER_WIDTH, BUFFER_HEIGHT);
	float3 c = 0.0;
	[unroll] for (int i = 0; i < 32; i++)
		c += TOPT_M_Taps32_k0[i].z * tex2Dlod(TOPT_sBackBuffer, float4(uv + TOPT_M_Taps32_k0[i].xy * px, 0.0, 0.0)).rgb;
	return float4(c, 1.0);
}
static const float3 TOPT_M_Taps32_k1[1] = {
	float3(0.0, 0.0, 1.0)
};
float4 TOPT_M_Taps32_PS1(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
	const float2 px = 1.0 / float2(BUFFER_WIDTH, BUFFER_HEIGHT);
	float3 c = 0.0;
	[unroll] for (int i = 0; i < 1; i++)
		c += TOPT_M_Taps32_k1[i].z * tex2Dlod(TOPT_M_Taps32_s0, float4(uv + TOPT_M_Taps32_k1[i].xy * px, 0.0, 0.0)).rgb;
	float3 o = tex2D(ReShade::BackBuffer, uv).rgb;
	return float4(lerp(o, c, TOPT_Strength), 1.0);
}
