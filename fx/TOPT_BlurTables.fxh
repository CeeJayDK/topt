			#define BLUR_GPU_NAME "Intel Xe-LPG (Meteor Lake)"
		#else
			#define BLUR_GPU 0
			#define BLUR_GPU_NAME "Intel, unknown model"
		#endif
	#else
		#define BLUR_GPU 0 // unknown GPU: least regret over all profiles
		#define BLUR_GPU_NAME "unknown"
	#endif
#endif
#ifndef BLUR_GPU_NAME
	#define BLUR_GPU_NAME "set by hand (BLUR_GPU)"
#endif

// Per table: BLUR_CHOICE = 2 * class + separable, by the blur sigma on screen (px).
