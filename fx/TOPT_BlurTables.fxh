		#elif __DEVICE__ >= 0xA780 && __DEVICE__ <= 0xA7FF // Iris Xe profile
			#define BLUR_GPU 8
			#define BLUR_GPU_NAME "Intel Gen12 (Raptor Lake)"
		#elif __DEVICE__ >= 0x5690 && __DEVICE__ <= 0x56FF // Arc B580 profile
			#define BLUR_GPU 7
			#define BLUR_GPU_NAME "Intel Arc (Alchemist)"
		#elif __DEVICE__ >= 0xE200 && __DEVICE__ <= 0xE2FF // Arc B580 profile
