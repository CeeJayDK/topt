			#define BLUR_GPU 8
			#define BLUR_GPU_NAME "Intel Gen12 (Tiger Lake)"
		#elif __DEVICE__ >= 0x4680 && __DEVICE__ <= 0x46FF // Iris Xe profile
			#define BLUR_GPU 8
