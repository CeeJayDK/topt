			#define BLUR_GPU 4
			#define BLUR_GPU_NAME "AMD Ryzen iGPUs (RDNA 2 / 3)"
		#else
			#define BLUR_GPU 0
			#define BLUR_GPU_NAME "AMD, unknown model"
		#endif
	#elif __VENDOR__ == 0x8086 // Intel
		#if __DEVICE__ >= 0x1900 && __DEVICE__ <= 0x193F // UHD 630 profile
			#define BLUR_GPU 9
			#define BLUR_GPU_NAME "Intel Gen9 (Skylake)"
		#elif __DEVICE__ >= 0x5900 && __DEVICE__ <= 0x59FF // UHD 630 profile
			#define BLUR_GPU 9
			#define BLUR_GPU_NAME "Intel Gen9.5 (Kaby Lake)"
