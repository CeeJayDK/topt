/*
  TOPT_BlurTables.fxh: the size classes of the topt blur (TOPT_Blur.fx, MovieNight.fx), generated by
  scripts/make_effect.py.

  BLUR_GPU: the table of the GPU's family (PCI vendor / device id ranges), each made with the cost model
  calibrated on that architecture's TexBench report; 0 = unknown GPU (least regret over all of them).
  Define BLUR_GPU to force one. Each table gives the size class for the blur sigma on screen
  (BLUR_SIGMA_SCREEN, px), and the class block below its constants: downsample factors and taps, the
  low-res sigma range and the upsample taps.
*/

#ifndef BLUR_GPU
	#if __VENDOR__ == 0x10DE // NVIDIA
		#if __DEVICE__ >= 0x1340 && __DEVICE__ <= 0x17FF // GTX 860M profile
			#define BLUR_GPU 11
			#define BLUR_GPU_NAME "NVIDIA Maxwell"
		#elif __DEVICE__ >= 0x1B00 && __DEVICE__ <= 0x1DFF // GTX 1080 profile
			#define BLUR_GPU 6
			#define BLUR_GPU_NAME "NVIDIA Pascal"
		#elif __DEVICE__ >= 0x2180 && __DEVICE__ <= 0x21FF // GTX 1660 profile
			#define BLUR_GPU 10
			#define BLUR_GPU_NAME "NVIDIA Turing GTX 16 (TU116)"
		#elif __DEVICE__ >= 0x1E00 && __DEVICE__ <= 0x1FFF // RTX 2070 profile
			#define BLUR_GPU 12
			#define BLUR_GPU_NAME "NVIDIA Turing (TU10x, TU117)"
		#elif __DEVICE__ >= 0x2200 && __DEVICE__ <= 0x25FF // RTX 3060 profile
			#define BLUR_GPU 13
			#define BLUR_GPU_NAME "NVIDIA Ampere"
		#elif __DEVICE__ >= 0x2600 && __DEVICE__ <= 0x28FF // RTX 4070 profile
			#define BLUR_GPU 14
			#define BLUR_GPU_NAME "NVIDIA Ada"
		#elif __DEVICE__ >= 0x2900 && __DEVICE__ <= 0x2FFF // RTX 5070 profile
			#define BLUR_GPU 14
			#define BLUR_GPU_NAME "NVIDIA Blackwell"
		#else
			#define BLUR_GPU 0
			#define BLUR_GPU_NAME "NVIDIA, unknown model"
		#endif
	#elif __VENDOR__ == 0x1002 // AMD
		#if __DEVICE__ >= 0x6700 && __DEVICE__ <= 0x69FF // RX 590 profile
			#define BLUR_GPU 6
			#define BLUR_GPU_NAME "AMD GCN (Polaris, Vega)"
		#elif __DEVICE__ >= 0x7310 && __DEVICE__ <= 0x739F // RX 5500 XT profile
			#define BLUR_GPU 5
			#define BLUR_GPU_NAME "AMD RDNA 1"
