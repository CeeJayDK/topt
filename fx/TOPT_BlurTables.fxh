/*
  TOPT_BlurTables.fxh: the size classes of the topt blur (TOPT_Blur.fx, MovieNight.fx), generated by
  scripts/make_effect.py.

  TOPT_GPU: the table of the GPU's family (PCI vendor / device id ranges), each made with the cost model
  calibrated on that architecture's TexBench report; 0 = unknown GPU (least regret over all of them).
  Define TOPT_GPU to force one. Each table gives the size class for the blur sigma on screen
  (TOPT_SIGMA_SCREEN, px), and the class block below its constants: downsample factors and taps, the
  low-res sigma range and the upsample taps.
*/

#ifndef TOPT_GPU
	#if __VENDOR__ == 0x10DE // NVIDIA
		#if __DEVICE__ >= 0x1340 && __DEVICE__ <= 0x17FF // NVIDIA Maxwell (GTX 860M profile)
			#define TOPT_GPU 11
		#elif __DEVICE__ >= 0x1B00 && __DEVICE__ <= 0x1DFF // NVIDIA Pascal (GTX 1080 profile)
			#define TOPT_GPU 6
		#elif __DEVICE__ >= 0x2180 && __DEVICE__ <= 0x21FF // NVIDIA Turing GTX 16 (TU116) (GTX 1660 profile)
			#define TOPT_GPU 10
		#elif __DEVICE__ >= 0x1E00 && __DEVICE__ <= 0x1FFF // NVIDIA Turing (TU10x, TU117) (RTX 2070 profile)
			#define TOPT_GPU 12
		#elif __DEVICE__ >= 0x2200 && __DEVICE__ <= 0x25FF // NVIDIA Ampere (RTX 3060 profile)
			#define TOPT_GPU 13
		#elif __DEVICE__ >= 0x2600 && __DEVICE__ <= 0x28FF // NVIDIA Ada (RTX 4070 profile)
			#define TOPT_GPU 14
		#elif __DEVICE__ >= 0x2900 && __DEVICE__ <= 0x2FFF // NVIDIA Blackwell (RTX 5070 profile)
			#define TOPT_GPU 14
		#else
			#define TOPT_GPU 0
		#endif
	#elif __VENDOR__ == 0x1002 // AMD
		#if __DEVICE__ >= 0x6700 && __DEVICE__ <= 0x69FF // AMD GCN (Polaris, Vega) (RX 590 profile)
			#define TOPT_GPU 6
		#elif __DEVICE__ >= 0x7310 && __DEVICE__ <= 0x739F // AMD RDNA 1 (RX 5500 XT profile)
			#define TOPT_GPU 5
		#elif __DEVICE__ >= 0x73A0 && __DEVICE__ <= 0x743F // AMD RDNA 2 (RX 6600 profile)
			#define TOPT_GPU 1
		#elif __DEVICE__ >= 0x7440 && __DEVICE__ <= 0x74FF // AMD RDNA 3 (RX 7900 XTX profile)
			#define TOPT_GPU 2
		#elif __DEVICE__ >= 0x7500 && __DEVICE__ <= 0x75FF // AMD RDNA 4 (RX 9070 XT profile)
			#define TOPT_GPU 3
		#elif __DEVICE__ >= 0x1500 && __DEVICE__ <= 0x19FF // AMD Ryzen iGPUs (RDNA 2 / 3) (Radeon 680M profile)
			#define TOPT_GPU 4
		#else
			#define TOPT_GPU 0
		#endif
	#elif __VENDOR__ == 0x8086 // Intel
		#if __DEVICE__ >= 0x1900 && __DEVICE__ <= 0x193F // Intel Gen9 (Skylake) (UHD 630 profile)
			#define TOPT_GPU 9
		#elif __DEVICE__ >= 0x5900 && __DEVICE__ <= 0x59FF // Intel Gen9.5 (Kaby Lake) (UHD 630 profile)
			#define TOPT_GPU 9
		#elif __DEVICE__ >= 0x3E90 && __DEVICE__ <= 0x3EFF // Intel Gen9.5 (Coffee Lake) (UHD 630 profile)
			#define TOPT_GPU 9
		#elif __DEVICE__ >= 0x9B00 && __DEVICE__ <= 0x9BFF // Intel Gen9.5 (Comet Lake) (UHD 630 profile)
			#define TOPT_GPU 9
		#elif __DEVICE__ >= 0x9A40 && __DEVICE__ <= 0x9AFF // Intel Gen12 (Tiger Lake) (Iris Xe profile)
			#define TOPT_GPU 8
		#elif __DEVICE__ >= 0x4680 && __DEVICE__ <= 0x46FF // Intel Gen12 (Alder Lake) (Iris Xe profile)
			#define TOPT_GPU 8
		#elif __DEVICE__ >= 0xA780 && __DEVICE__ <= 0xA7FF // Intel Gen12 (Raptor Lake) (Iris Xe profile)
			#define TOPT_GPU 8
		#elif __DEVICE__ >= 0x5690 && __DEVICE__ <= 0x56FF // Intel Arc (Alchemist) (Arc B580 profile)
			#define TOPT_GPU 7
		#elif __DEVICE__ >= 0xE200 && __DEVICE__ <= 0xE2FF // Intel Arc (Battlemage) (Arc B580 profile)
			#define TOPT_GPU 7
		#elif __DEVICE__ >= 0x6400 && __DEVICE__ <= 0x64FF // Intel Xe2 (Lunar Lake) (Arc B580 profile)
			#define TOPT_GPU 7
		#elif __DEVICE__ >= 0x7D40 && __DEVICE__ <= 0x7DFF // Intel Xe-LPG (Meteor Lake) (Arc B580 profile)
			#define TOPT_GPU 7
		#else
			#define TOPT_GPU 0
		#endif
	#else
		#define TOPT_GPU 0 // unknown GPU: least regret over all profiles
	#endif
#endif

// Per table: TOPT_CHOICE = 2 * class + separable, by the blur sigma on screen (px).
