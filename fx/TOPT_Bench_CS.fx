		p = max(p, -1 - p);            // mirror addressing
		p = min(p, 2 * size - 1 - p);
		TOPT_C_SplitHV_s1_tile[i] = tex2Dfetch(ReShade::BackBuffer, p).rgb;
	}
	barrier();
	const uint b = tid.y * 22 + tid.x + 3;
	float3 c = TOPT_C_SplitHV_s1_w[0] * TOPT_C_SplitHV_s1_tile[b];
