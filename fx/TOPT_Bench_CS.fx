// Auto-generated by topt - compute tile blur (separable Gaussian in groupshared memory).
// Compute shaders cannot write the screen, so a composite pixel shader follows.
#include "ReShade.fxh"

#if __RENDERER__ >= 0xb000

#ifndef TOPT_FORMAT
	#define TOPT_FORMAT RGB10A2
#endif

uniform float TOPT_Strength < ui_type = "slider"; ui_min = 0.0; ui_max = 1.0; > = 1.0;

// ---- TOPT_C_Tile_s1: sigma 1, radius 3, 16x16 tile
texture TOPT_C_Tile_s1_tOut { Width = BUFFER_WIDTH; Height = BUFFER_HEIGHT; Format = TOPT_FORMAT; };
storage2D TOPT_C_Tile_s1_stOut { Texture = TOPT_C_Tile_s1_tOut; };
sampler TOPT_C_Tile_s1_sOut { Texture = TOPT_C_Tile_s1_tOut; };
static const float TOPT_C_Tile_s1_w[4] = { 0.398214588, 0.24203727, 0.0543472392, 0.00450819703 };
groupshared float3 TOPT_C_Tile_s1_tile[22 * 22];
groupshared float3 TOPT_C_Tile_s1_row[22 * 16];

void TOPT_C_Tile_s1_CS(uint3 gid : SV_GroupID, uint3 tid : SV_GroupThreadID)
{
	const int2 size = int2(BUFFER_WIDTH, BUFFER_HEIGHT);
	const int2 origin = int2(gid.xy) * 16 - 3;
	const uint lin = tid.y * 16 + tid.x;
	for (uint i = lin; i < 22 * 22; i += 16 * 16)
	{
		int2 p = origin + int2(i % 22, i / 22);
		p = max(p, -1 - p);            // mirror addressing
		p = min(p, 2 * size - 1 - p);
		TOPT_C_Tile_s1_tile[i] = tex2Dfetch(ReShade::BackBuffer, p).rgb;
	}
	barrier();
	for (uint j = lin; j < 22 * 16; j += 16 * 16)
	{
		const uint b = (j / 16) * 22 + (j % 16) + 3;
		float3 c = TOPT_C_Tile_s1_w[0] * TOPT_C_Tile_s1_tile[b];
		[unroll] for (int k = 1; k <= 3; k++)
			c += TOPT_C_Tile_s1_w[k] * (TOPT_C_Tile_s1_tile[b - k] + TOPT_C_Tile_s1_tile[b + k]);
		TOPT_C_Tile_s1_row[j] = c;
	}
	barrier();
	const uint b = (tid.y + 3) * 16 + tid.x;
	float3 c = TOPT_C_Tile_s1_w[0] * TOPT_C_Tile_s1_row[b];
	[unroll] for (int k = 1; k <= 3; k++)
		c += TOPT_C_Tile_s1_w[k] * (TOPT_C_Tile_s1_row[b - k * 16] + TOPT_C_Tile_s1_row[b + k * 16]);
	const int2 o = int2(gid.xy) * 16 + int2(tid.xy);
	if (all(o < size))
		tex2Dstore(TOPT_C_Tile_s1_stOut, o, float4(c, 1.0));
}

float4 TOPT_C_Tile_s1_PS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
	const float3 o = tex2D(ReShade::BackBuffer, uv).rgb;
	return float4(lerp(o, tex2D(TOPT_C_Tile_s1_sOut, uv).rgb, TOPT_Strength), 1.0);
}

technique TOPT_C_Tile_s1 < ui_tooltip = "Compute tile blur sigma 1 (r=3) + composite pixel shader"; >
{
	pass { ComputeShader = TOPT_C_Tile_s1_CS<16, 16>; DispatchSizeX = (BUFFER_WIDTH + 16 - 1) / 16; DispatchSizeY = (BUFFER_HEIGHT + 16 - 1) / 16; }
	pass { VertexShader = PostProcessVS; PixelShader = TOPT_C_Tile_s1_PS; }
}

