	float3(0.0, 0.0, 1.0)
};
float4 TOPT_B_pyramid_s16_PS5(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
	const float2 px = 1.0 / float2(BUFFER_WIDTH / 2, BUFFER_HEIGHT / 2);
	float3 c = 0.0;
	[unroll] for (int i = 0; i < 1; i++)
		c += TOPT_B_pyramid_s16_k5[i].z * tex2Dlod(TOPT_B_pyramid_s16_s4, float4(uv + TOPT_B_pyramid_s16_k5[i].xy * px, 0.0, 0.0)).rgb;
	float3 o = tex2D(ReShade::BackBuffer, uv).rgb;
	return float4(lerp(o, c, TOPT_Strength), 1.0);
}
technique TOPT_B_pyramid_s16 < ui_tooltip = "sigma 16 classic pyramid k=2 chain m=12"; >
