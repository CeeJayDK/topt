/*------------------.
| :: Description :: |
'-------------------/

	Movie Night (name not final)

	Author: CeeJay.dk
	License: MIT

	About:
	Fills the black bars of letterboxed (or pillarboxed) video with a soft,
	blurred continuation of the picture.

	The blur is the topt blur (TOPT_Blur.fx, generated by the topt texture-sample
	optimizer): a wide downsample, a Gaussian at low resolution and a smooth
	upsample. Its passes only draw the strips of the picture next to the bars
	(plus the reach of the blur), and the downsample reads the screen clamped to
	the picture, so the black bars do not darken the glow.

	History:
	(*) Feature (+) Improvement	(x) Bugfix (-) Information (!) Compatibility

	Version 0.4 WIP
	* Real blur (topt) instead of the noise-scattered read; left / right bars
	  map the picture the same way as top / bottom.
*/

#ifndef MOVIENIGHT_BLUR_SIZE
	#define MOVIENIGHT_BLUR_SIZE 32 // blur sigma in pixels at 1080p (2..200); scales with resolution
#endif
#define TOPT_BLUR_SIZE MOVIENIGHT_BLUR_SIZE

uniform float Top <
	ui_type = "drag"; ui_min = 0.0; ui_max = 1000.0; ui_step = 1.0;
	ui_label = "Top bar (px)";
> = 278.0;

uniform float Bottom <
	ui_type = "drag"; ui_min = 0.0; ui_max = 1000.0; ui_step = 1.0;
	ui_label = "Bottom bar (px)";
> = 278.0;

uniform float Left <
	ui_type = "drag"; ui_min = 0.0; ui_max = 1000.0; ui_step = 1.0;
	ui_label = "Left bar (px)";
> = 0.0;

uniform float Right <
	ui_type = "drag"; ui_min = 0.0; ui_max = 1000.0; ui_step = 1.0;
	ui_label = "Right bar (px)";
> = 0.0;

uniform float Opacity <
	ui_type = "drag"; ui_min = 0.0; ui_max = 1.0; ui_step = 0.01;
	ui_label = "Opacity";
> = 0.5;

uniform float Zoom <
	ui_type = "drag"; ui_min = 1.0; ui_max = 10.0; ui_step = 0.1;
	ui_label = "Zoom (bar geometry, for testing)";
> = 1.0;

static const float2 MN_PX = float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT);

// The picture rectangle (uv), between the bars.
float2 MN_PicMin() { return float2(Left, Top) * MN_PX; }
float2 MN_PicMax() { return 1.0 - float2(Right, Bottom) * MN_PX; }

// The blur reads the screen only inside the picture (half a pixel in), so the bars do not darken it.
#define TOPT_SRC_UV(uv) clamp(uv, MN_PicMin() + 0.5 * MN_PX, MN_PicMax() - 0.5 * MN_PX)

#include "ReShade.fxh"

#ifndef TOPT_BLUR_SIZE
	#define TOPT_BLUR_SIZE 16 // blur sigma in pixels at 1080p (integer, 1..200; 1 = single pass, 0.7..1.3 with the fine-tune); scales with resolution
#endif
#ifndef TOPT_BLUR_FORMAT
	#define TOPT_BLUR_FORMAT RGB10A2 // intermediate format; R11G11B10F keeps HDR (> 1) values
#endif
#ifndef TOPT_BLUR_LUMA
	#define TOPT_BLUR_LUMA 0 // 1: blur brightness only (one-channel buffers); the composite keeps the colour detail
#endif
#ifndef TOPT_BLUR_LUMA_FORMAT
	#define TOPT_BLUR_LUMA_FORMAT R16F // brightness-only buffers: R16F or R8
#endif
#ifndef TOPT_BLUR_FROST
	#define TOPT_BLUR_FROST 0 // 1: scatter the final read inside a disk (frosted glass)
#endif
#ifndef TOPT_BLUR_FROST_NOISE
	#define TOPT_BLUR_FROST_NOISE 0 // frosted glass noise: 0 blue-noise texture (Textures/topt_bn64_RG8.png), 1 IGN
#endif
#ifndef TOPT_BLUR_BLEND
	#define TOPT_BLUR_BLEND 0 // 1: blend with the screen by the output-merger blend state instead of in the shader
#endif

#define TOPT_SIGMA_SCREEN (TOPT_BLUR_SIZE * BUFFER_HEIGHT / 1080)

uniform float TOPT_SizeTune <
	ui_type = "slider"; ui_min = 0.7; ui_max = 1.33;
	ui_label = "Size fine-tune";
	ui_tooltip = "Multiplies the blur size set by TOPT_BLUR_SIZE.\nThe usable range of each size class is limited; the blur stops growing at its edges.";
> = 1.0;

// ---- size class (chosen at compile time from the blur size, the resolution and the GPU: each GPU
// family gets the choices the cost model, calibrated on its TexBench report, finds cheapest.
// TOPT_GPU forces a table, e.g. to time them against each other.)
#ifndef TOPT_GPU
	#if __VENDOR__ == 0x10DE && __DEVICE__ >= 0x1340 && __DEVICE__ <= 0x17FF
		#define TOPT_GPU 11 // NVIDIA Maxwell (GTX 860M profile)
	#elif __VENDOR__ == 0x10DE && __DEVICE__ >= 0x1B00 && __DEVICE__ <= 0x1DFF
		#define TOPT_GPU 6 // NVIDIA Pascal (GTX 1080 profile)
	#elif __VENDOR__ == 0x10DE && __DEVICE__ >= 0x2180 && __DEVICE__ <= 0x21FF
		#define TOPT_GPU 10 // NVIDIA Turing GTX 16 (TU116) (GTX 1660 profile)
	#elif __VENDOR__ == 0x10DE && __DEVICE__ >= 0x1E00 && __DEVICE__ <= 0x1FFF
		#define TOPT_GPU 12 // NVIDIA Turing (TU10x, TU117) (RTX 2070 profile)
