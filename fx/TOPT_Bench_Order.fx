	float3(0.0, 2.0, 0.015625),
	float3(-6.0, -4.0, 0.015625)
};
float4 TOPT_O_Down16_random_PS0(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
	const float2 px = 1.0 / float2(BUFFER_WIDTH, BUFFER_HEIGHT);
	float3 c = 0.0;
	[unroll] for (int i = 0; i < 81; i++)
		c += TOPT_O_Down16_random_k0[i].z * tex2Dlod(TOPT_sBackBuffer, float4(uv + TOPT_O_Down16_random_k0[i].xy * px, 0.0, 0.0)).rgb;
	return float4(c, 1.0);
}
static const float3 TOPT_O_Down16_random_k1[1] = {
	float3(0.0, 0.0, 1.0)
};
float4 TOPT_O_Down16_random_PS1(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
	const float2 px = 1.0 / float2(BUFFER_WIDTH / 16, BUFFER_HEIGHT / 16);
	float3 c = 0.0;
	[unroll] for (int i = 0; i < 1; i++)
		c += TOPT_O_Down16_random_k1[i].z * tex2Dlod(TOPT_O_Down16_random_s0, float4(uv + TOPT_O_Down16_random_k1[i].xy * px, 0.0, 0.0)).rgb;
	float3 o = tex2D(ReShade::BackBuffer, uv).rgb;
	return float4(lerp(o, c, TOPT_Strength), 1.0);
}
technique TOPT_O_Down16_random < ui_tooltip = "x16 downsample, 81 taps, fetch order: random"; >
{
	pass p0_0 { VertexShader = PostProcessVS; PixelShader = TOPT_O_Down16_random_PS0; RenderTarget = TOPT_O_Down16_random_t0; }
	pass p0_1 { VertexShader = PostProcessVS; PixelShader = TOPT_O_Down16_random_PS1; }
}
